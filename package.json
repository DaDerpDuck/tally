{
  "name": "tally-effects",
  "version": "0.0.0",
  "description": "A composable, source-driven status effect framework for deriving and replicating gameplay state.",
  "license": "MIT",
  "author": "DaDerpDuck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaDerpDuck/tally"
  },
  "bugs": {
    "url": "https://github.com/DaDerpDuck/tally/issues"
  },
  "homepage": "https://github.com/DaDerpDuck/tally#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE.txt"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typetest": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
